# ZezEdit 2.0 Configuration Example
# Copy to .env and adjust as needed. Never commit .env to Git.

# Application
ZEZEDIT_APP_NAME=ZezEdit
ZEZEDIT_APP_VERSION=2.0.0-alpha.1
ZEZEDIT_ENVIRONMENT=development
ZEZEDIT_DEBUG=false

# Server
ZEZEDIT_API_HOST=127.0.0.1
ZEZEDIT_API_PORT=8000
ZEZEDIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Root (configurable; never point to a drive root like D:\)
ZEZEDIT_STORAGE_ROOT=D:\ZezEdit\storage

# Media Binaries (leave empty to auto-detect on PATH)
ZEZEDIT_FFMPEG_PATH=
ZEZEDIT_FFPROBE_PATH=

# Local AI Runtime (Ollama)
ZEZEDIT_OLLAMA_BASE_URL=http://127.0.0.1:11434
ZEZEDIT_DEFAULT_MODEL=qwen3-vl:4b-instruct
ZEZEDIT_OLLAMA_TIMEOUT_SECONDS=8.0

# Worker & Hardware Resource Limits (CPU-first defaults for Intel i3-1220P)
ZEZEDIT_MAX_CONCURRENT_JOBS=1
ZEZEDIT_FFMPEG_THREADS=4
ZEZEDIT_MAX_MEMORY_MB=8192

# Logging
ZEZEDIT_LOG_LEVEL=INFO
